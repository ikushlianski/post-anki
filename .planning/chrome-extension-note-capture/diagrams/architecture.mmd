flowchart TB
  subgraph Capture["P1 - Capture"]
    Ext["Chrome extension<br/>(popup + context menu)"]
    Cap["captures table<br/>(subjectId required, curriculum/module/topic optional)"]
    Ext -->|"POST /captures<br/>Bearer: extension token"| Cap
  end

  subgraph Organize["P2 - Organize"]
    Web["apps/web:<br/>Organize captures screen"]
    Src["curricula.sources<br/>(existing table)"]
    Reparse["existing reparse job<br/>(curriculum-architect)"]
    Confirm["existing confirmCurriculum<br/>+ deleteModule"]
    Web -->|"select unfiled captures<br/>+ target curriculum"| Src
    Src --> Reparse
    Reparse -->|"status: ready"| Confirm
  end

  Cap -->|"curriculumId IS NULL<br/>= needs organizing"| Web
  Confirm -->|"modules/topics exist"| ReadSurface["apps/web:<br/>curriculum detail page<br/>(existing) + captures list (new)"]
  Cap -->|"curriculumId/moduleId set<br/>(direct filing or post-promote)"| ReadSurface

  classDef default fill:#f5f5f5,stroke:#333,stroke-width:1px,color:#000
  linkStyle default stroke:#333,stroke-width:1px
