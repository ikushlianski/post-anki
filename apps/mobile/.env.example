# @post-anki/mobile — copy to apps/mobile/.env to point at a non-default apps/api.

# Base URL of apps/api. Defaults to http://localhost:8030 (the local dev server)
# if unset — only needed once you point the app at a deployed apps/api instance.
# Must be prefixed EXPO_PUBLIC_ to be readable from the client bundle.
EXPO_PUBLIC_API_BASE_URL=
