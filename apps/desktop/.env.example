# Build-time URL the desktop shell's webview loads. This is the ONLY config value
# this app reads — no API keys, no backend credentials, no backend service base URL.
#
# Release builds (tauri:build) default to the production apps/web origin baked into
# tauri.conf.json below, so leave this unset for a normal release build.
#
# For local development against `npm run dev:web` (vite dev on :5540), override it:
# DESKTOP_APP_URL=http://localhost:5540
DESKTOP_APP_URL=https://postanki.ilya.online
