{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Post Anki",
  "version": "0.1.0",
  "identifier": "online.ilya.postanki.desktop",
  "build": {
    "devUrl": "http://localhost:5540",
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Post Anki",
        "url": "/",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
