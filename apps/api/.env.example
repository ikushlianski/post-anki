# @post-anki/api local dev env.
#
# Two-file setup (both gitignored):
#   .env        committed-shape base: local Postgres + non-secret defaults.
#   .env.local  secrets/overrides (e.g. OPENROUTER_API_KEY). Loaded last, wins.
#
# Prod does NOT use these files — Cloud Run env vars come from GitHub Secrets
# (PROD_DATABASE_URL, PROD_OPENROUTER_API_KEY, ...) via .github/workflows/deploy.yml.

# --- .env ---

# Local dev Postgres (docker compose up -> container post-anki-dev-db on :5562).
# Persistent volume, separate from the ephemeral e2e DB on :5578.
DATABASE_URL=postgres://postanki:postanki@localhost:5562/postanki_dev

# gpt-4o-mini: cheapest option that supports structured output + web search
# (tool calling) in a single call. Gemini 2.5 Flash cannot combine the two.
CURRICULUM_MODEL=openrouter/openai/gpt-4o-mini

# Voice responses (#22) — its own var, not a reuse of CURRICULUM_MODEL above:
# gpt-4o-mini (this file's own CURRICULUM_MODEL value) is text-only, so
# reusing it would silently break transcription in local dev.
TRANSCRIPTION_MODEL=openrouter/google/gemini-2.5-flash

# Bearer shared with the web BFF. Must match apps/web/.env (API_SHARED_SECRET).
API_SHARED_SECRET=local-dev-secret

# Local dev Electric sync service (docker compose up -> container
# post-anki-dev-electric, host port 5561 -> container port 3000).
# Prod equivalent is set via Pulumi (Cloud Run service URL), not this file.
ELECTRIC_SERVICE_URL=http://localhost:5561

# "iam" (default, omit this var in prod) mints a GCP ID token for the
# private Cloud Run Electric service. "none" skips token minting entirely —
# only safe for the unauthenticated local docker-compose Electric container.
ELECTRIC_AUTH_MODE=none

PORT=5560
LOG_LEVEL=info

# The web app's origin, for CORS. Defaults to the local dev web port; prod
# sets this to the deployed web service's real URL (see deploy.yml).
WEB_ORIGIN=http://localhost:5540

# --- .env.local ---

# OpenRouter API key — same key for local dev and prod. Paste yours here.
OPENROUTER_API_KEY=

# Langfuse tracing (Cloud EU). Both keys present → Mastra exports agent/LLM
# traces to Langfuse. Leave blank → tracing is gracefully disabled.
# Prod reads these from GitHub Secrets PROD_LANGFUSE_* (see deploy.yml).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
