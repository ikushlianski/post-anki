# @post-anki/api local dev env.
#
# Two-file setup (both gitignored):
#   .env        committed-shape base: local Postgres + non-secret defaults.
#   .env.local  secrets/overrides (e.g. OPENROUTER_API_KEY). Loaded last, wins.
#
# Prod does NOT use these files — Cloud Run env vars come from GitHub Secrets
# (PROD_DATABASE_URL, PROD_OPENROUTER_API_KEY, ...) via .github/workflows/deploy.yml.

# --- .env ---

# Local dev Postgres (docker compose up -> container post-anki-dev-db on :5562).
# Persistent volume, separate from the ephemeral e2e DB on :5578.
DATABASE_URL=postgres://postanki:postanki@localhost:5562/postanki_dev

# gpt-4o-mini: cheapest option that supports structured output + web search
# (tool calling) in a single call. Gemini 2.5 Flash cannot combine the two.
CURRICULUM_MODEL=openrouter/openai/gpt-4o-mini

# Voice responses (#22) — its own var, not a reuse of CURRICULUM_MODEL above:
# gpt-4o-mini (this file's own CURRICULUM_MODEL value) is text-only, so
# reusing it would silently break transcription in local dev.
TRANSCRIPTION_MODEL=openrouter/google/gemini-2.5-flash

# Bearer shared with the web BFF. Must match apps/web/.env (API_SHARED_SECRET).
API_SHARED_SECRET=local-dev-secret

# Local dev Electric sync service (docker compose up -> container
# post-anki-dev-electric, host port 5561 -> container port 3000).
# Prod equivalent is set via Pulumi (Cloud Run service URL), not this file.
ELECTRIC_SERVICE_URL=http://localhost:5561

# "iam" (default, omit this var in prod) mints a GCP ID token for the
# private Cloud Run Electric service. "none" skips token minting entirely —
# only safe for the unauthenticated local docker-compose Electric container.
ELECTRIC_AUTH_MODE=none

PORT=5560
LOG_LEVEL=info

# The web app's origin, for CORS. Defaults to the local dev web port; prod
# sets this to the deployed web service's real URL (see deploy.yml).
WEB_ORIGIN=http://localhost:5540

# Extra web origins allowed by CORS, comma-separated (e.g. a custom domain alongside the Cloud Run URL). Optional.
# WEB_ORIGINS=https://www.example.com

# Highlight-capture browser extension id; when set, chrome-extension://<id> is added to the CORS allow-list. Optional.
# EXTENSION_ID=

# --- .env.local ---

# OpenRouter API key — same key for local dev and prod. Paste yours here.
# Required unless LLM_MODE=mock.
OPENROUTER_API_KEY=

# LLM_MODE=mock runs with no key and no cost: `npm run dev` starts scripts/mock-llm.mjs and the API
# sends chat and embeddings there (OPENROUTER_BASE_URL defaults to http://127.0.0.1:$MOCK_LLM_PORT/v1).
# Answers are placeholder text/JSON, not real content. Default is real.
# LLM_MODE=mock
# MOCK_LLM_PORT=4989

# LLM_MODE=cheap runs real calls but forces the cheap tier model (deepseek-v4-flash) for every agent.
# LLM_DAILY_BUDGET_USD: estimated spend cap per UTC day across chat, embeddings and transcription.
# Once reached, further calls fail with LlmBudgetExceededError; warnings log at 80% and at the cap.
# 0 = unlimited. Never counted or enforced in mock mode. In-memory per API process.
# LLM_MODE=cheap
# LLM_DAILY_BUDGET_USD=5

# Langfuse tracing (Cloud EU). Both keys present → Mastra exports agent/LLM
# traces to Langfuse. Leave blank → tracing is gracefully disabled.
# Prod reads these from GitHub Secrets PROD_LANGFUSE_* (see deploy.yml).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Durable cards: set DURABLE_CARDS=1 to run card generation as Inngest jobs that survive an API restart.
# Off by default (in-process). Same Inngest server and signing requirements as DURABLE_EXTRACTION.
# DURABLE_CARDS=

# Durable course jobs: set DURABLE_COURSE_JOBS=1 to run course source research as Inngest jobs
# that survive an API restart. Off by default (in-process). Same Inngest and signing requirements.
# DURABLE_COURSE_JOBS=

# Inngest request signing. Required when DURABLE_EXTRACTION, DURABLE_CARDS or DURABLE_COURSE_JOBS is on and INNGEST_DEV is not 1
# (the API refuses to boot without it). The self-hosted Inngest server must use the same key.
# INNGEST_SIGNING_KEY=
# Previous key, accepted during rotation. Optional.
# INNGEST_SIGNING_KEY_FALLBACK=
# Set to 1 for local dev with `npm run inngest:dev` (unsigned, no key needed).
# INNGEST_DEV=1

# PowerSync sync tokens (POST /sync-tokens) and the public key set (GET /sync-keys).
# EC P-256 private key in PKCS8 PEM, newlines written as \n. Unset = both endpoints answer 503.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | awk 'NF {printf "%s\\n", $0}'
# SYNC_JWT_PRIVATE_KEY=
# SYNC_JWT_KEY_ID=sync-key-1
# Comma separated; must include an audience listed in PowerSync client_auth.audience.
# SYNC_JWT_AUDIENCE=http://localhost:5590
