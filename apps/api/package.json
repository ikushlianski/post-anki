{
  "name": "@post-anki/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --env-file-if-exists=.env.local --dns-result-order=ipv4first --no-network-family-autoselection --watch --import tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build:server": "node --import tsx scripts/build-server.ts",
    "build:lambda": "node --import tsx scripts/build-lambda.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:create-user": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/create-user.ts",
    "db:set-owner-password": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/set-owner-password.ts",
    "db:revoke-api-token": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/revoke-api-token.ts",
    "db:create-web-key": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/create-web-api-key.ts",
    "db:rebuild-review-points": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/rebuild-review-points.ts",
    "db:seed:subjects": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed-subjects.ts",
    "db:seed:business-sub-subjects": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed-business-sub-subjects.ts",
    "db:seed:knowledge-browser-demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed-knowledge-browser-demo.ts",
    "db:seed:subject-categories": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed-subject-categories.ts",
    "migrate:english-practice-data": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate-english-practice-data.ts",
    "db:seed:domain-taxonomy": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed-domain-taxonomy.ts",
    "eval:lessons": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/eval-lesson-extraction.ts",
    "reextract:sources": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/reextract-knowledge-sources.ts",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "notion:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/notion-sync.ts",
    "biz-education:distill": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/biz-education-distill.ts"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.2.11",
    "@mastra/core": "^1.37.1",
    "@mastra/langfuse": "^1.3.5",
    "@mastra/observability": "^1.14.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@notionhq/client": "^5.26.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@post-anki/core": "*",
    "@post-anki/shared": "*",
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.0",
    "html-to-text": "^10.0.1",
    "inngest": "4.23.0",
    "jose": "^6.2.3",
    "p-retry": "^7.1.1",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@inngest/test": "1.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
