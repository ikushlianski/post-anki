# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_CHAT_ID=

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/google/gemini-2.5-flash

# DB
# Local dev: point at the docker dev DB (docker compose up -> :5437).
#   DATABASE_URL=postgres://postanki:postanki@localhost:5437/postanki_dev
# Prod: injected by CI from GitHub Secret PROD_DATABASE_URL (Neon), not this file.
DATABASE_URL=

# Electric sync service (local dev only; read by docker-compose.yml, NOT by
# any app process). Must be the Neon DIRECT (non-pooled) connection string —
# same credentials as DATABASE_URL above but with "-pooler" removed from the
# hostname, since Electric's replication connection cannot go through PgBouncer.
ELECTRIC_DATABASE_URL=

# Runtime
PORT=8080
LOG_LEVEL=info

# API (@post-anki/api) — reuses OPENROUTER_API_KEY + DATABASE_URL above
CURRICULUM_MODEL=openrouter/google/gemini-2.5-flash
# Own var, not a reuse of CURRICULUM_MODEL — must stay audio-capable, and
# CURRICULUM_MODEL's own local-dev value in apps/api/.env.example is not.
TRANSCRIPTION_MODEL=openrouter/google/gemini-2.5-flash
API_SHARED_SECRET=
# api process reads PORT (defaults to 8030 if unset)
