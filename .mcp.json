{
  "mcpServers": {
    "mastra": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mastra/mcp-docs-server@latest"
      ],
      "env": {}
    },
    "postanki-local": {
      "type": "stdio",
      "command": "npm",
      "args": [
        "run",
        "-s",
        "mcp:stdio",
        "-w",
        "@post-anki/api"
      ],
      "env": {
        "ALLOW_REMOTE_DEV_DB": "1"
      }
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
